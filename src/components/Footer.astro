---
// Footer - single source of truth, included via layout
---
<footer class="py-10 border-t mt-12">
  <div class="max-w-6xl mx-auto px-4 flex flex-wrap justify-between">
    <div class="mb-8">
      <div class="font-medium text-xl">bruno</div>
      <p class="text-sm text-gray-500 mt-4">
        Logo from OpenMoji. License: CC BY-SA 4.0
      </p>
    </div>
    <div>
      <h1 class="font-medium">Company</h1>
      <ul class="mt-4 space-y-2">
        <li><a href="/privacy-policy" class="text-gray-500">Privacy Policy</a></li>
        <li><a href="/terms" class="text-gray-500">Terms</a></li>
        <li><a href="/support" class="text-gray-500">Support</a></li>
      </ul>
    </div>
    <div>
      <h1 class="font-medium">Links</h1>
      <ul class="mt-4 space-y-2">
        <li><a href="https://docs.usebruno.com" class="text-gray-500">Documentation</a></li>
        <li><a href="https://github.com/usebruno/bruno" class="text-gray-500">GitHub</a></li>
      </ul>
    </div>
    <div>
      <h1 class="font-medium">Community</h1>
      <ul class="mt-4 space-y-2">
        <li><a href="https://discord.com/invite/KgcZUncpjq" class="text-gray-500">Discord</a></li>
        <li><a href="https://twitter.com/use_bruno" class="text-gray-500">Twitter</a></li>
      </ul>
    </div>
  </div>
</footer>
